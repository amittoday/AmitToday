# Environment Variables for Amit Online Services (AOS)

# 1. Google Apps Script Configuration
# Follow Phase 1 instructions to get these from your GAS Deployment.
GAS_WEBAPP_URL="https://script.google.com/macros/s/.../exec"
GAS_SECRET_TOKEN="CHANGE_ME_SET_THIS_IN_SHEET_FOR_SECURITY"

# 2. Razorpay Keys
# Get these from your Razorpay Dashboard (Settings -> API Keys).
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# 3. Gemini API Key
# Required for OCR Word Counting.
# AI Studio automatically injects this as GEMINI_API_KEY.
# If testing locally, set it here.
GEMINI_API_KEY="your_gemini_api_key"

